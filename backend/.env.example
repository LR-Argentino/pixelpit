# Vorlage fuer backend/.env  ->  cp .env.example .env
#
# Diese Werte liest Docker Compose implizit aus backend/.env und setzt sie in
# compose.yaml ein. Spring Boot leitet daraus beim Start die Datasource ab
# (siehe README.md, Abschnitt "Woher kommt die Datasource?").
#
# .env selbst ist git-ignored und darf keine echten Credentials ins Repo tragen.

POSTGRES_USER=pixelpit-admin
POSTGRES_DB=pixelpitdb
POSTGRES_PW=change-me


# Keycloak
KC_USER=user
KC_PW=pw