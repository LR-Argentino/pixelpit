        <mxCell id="OXCGxcovLIBiyyutiJym-28" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;" value="Use Case &quot;Fremde Inhalte moderieren&quot; inkludiert :&lt;div&gt;- Fremde Threads schließen&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, wenn sie ausdiskutiert oder eskaliert sind&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Spam, Off‑Topic oder unangemessene&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Fremde Inhalte löschen&lt;/span&gt;&lt;/div&gt;" vertex="1">
