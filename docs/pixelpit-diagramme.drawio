        </mxCell>
        <mxCell id="er_n2" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Anonymisierung&lt;/b&gt; (DSGVO): Beim Löschen eines Accounts wird profiles.account_id = NULL (ON DELETE SET NULL) und username = &#39;deleted-&amp;lt;id&amp;gt;&#39;. Der Präfix &#39;deleted-&#39; ist für aktive Profile per CHECK gesperrt." vertex="1">
          <mxGeometry height="95" width="300" x="440" y="320" as="geometry" />
        </mxCell>
        <mxCell id="er_n3" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Zirkulärer FK:&lt;/b&gt; threads.solution_post_id → posts wird nachträglich per ALTER TABLE angelegt (ON DELETE SET NULL)." vertex="1">
          <mxGeometry height="60" width="300" x="1240" y="400" as="geometry" />
        </mxCell>
        <mxCell id="er_n4" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Legende&lt;/b&gt;&lt;br&gt;PK Primärschlüssel · FK Fremdschlüssel · UQ eindeutig&lt;br&gt;Krähenfuß: | genau eins · o| null oder eins · &amp;gt;| eins oder mehr · &amp;gt;o null oder mehr · - - - optionale Beziehung (Lösung)&lt;br&gt;Grün: Nutzer · Blau: Forum · Gelb: Dateien (Schema vorbereitet, noch ohne Upload) · Grau: technisch" vertex="1">
          <mxGeometry height="80" width="520" x="40" y="960" as="geometry" />
        </mxCell>
        <mxCell id="er_n5" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fillColor=#ffffff;strokeColor=#999999;" value="Die Rolle ist bewusst eine Enum-Spalte (CHECK) statt einer eigenen Tabelle: Es gibt genau drei feste Rollen, Berechtigungen sind im Code definiert." vertex="1">
          <mxGeometry height="70" width="300" x="40" y="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
