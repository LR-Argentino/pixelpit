        <mxCell id="er_n1" parent="1" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=10;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Soft Delete&lt;/b&gt; (threads, posts): CHECK (deleted_at IS NULL) = (deleted_by IS NULL). Gelöschte Inhalte bleiben gespeichert und werden beim Lesen ausgefiltert. deleted_by verweist (optional, 0..1) ebenfalls auf profiles.id – zur Übersicht nicht als Linie gezeichnet." vertex="1">
